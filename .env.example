# Organization portal API (Vitaway core-backend / care-api).
# Auth, password reset, and dashboard calls use this base.
# Do not set this to the legacy Laravel URL https://ehr.vitaway.org/api/organization.
NEXT_PUBLIC_API_BASE_URL=https://care-api.vitaway.org/api/v1

# Laravel EHR cross-calls used only by lib/ehr-client.ts.
NEXT_PUBLIC_EHR_API_URL=https://ehr.vitaway.org/api
